<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:AvaloniaNavigationView"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <controls:NavigationView />
    </Design.PreviewWith>
    <Style Selector="controls|NavigationView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*, auto">
                    <ContentControl Background="Transparent" x:Name="PART_Content" />
                    <ContentControl Grid.Row="1" x:Name="PART_Navigator" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>